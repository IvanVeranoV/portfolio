---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import {
  EDUCATION,
  EXPERIENCE,
  PROFILE,
  PROJECTS,
  SKILL_CATEGORIES,
  SOCIAL_LINKS,
} from "../config/constants";
---

<Layout title={`${PROFILE.name} | Portfolio`}>
  <main
    class="portfolio-shell mx-auto max-w-5xl space-y-24 px-6 py-12"
    id="inicio"
  >
    <section class="reveal relative space-y-6 pt-12 text-center md:text-left">
      <div class="hero-status">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-neon opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-neon"
          ></span>
        </span>
        Disponible para nuevos proyectos
      </div>

      <h1 class="hero-title">
        Hola, soy <span class="hero-name">{PROFILE.name}</span>
      </h1>

      <p class="hero-subtitle">
        {PROFILE.headline}
        <span class="text-slate-500">·</span>
        {PROFILE.location}
      </p>

      <p class="hero-summary">{PROFILE.summary}</p>

      <div
        class="flex flex-wrap items-center justify-center gap-4 pt-2 md:justify-start"
      >
        <a href={`mailto:${PROFILE.email}`} class="contact-button">
          Contactar ahora
        </a>

        <div class="flex gap-2">
          {
            SOCIAL_LINKS.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.platform}
                class="social-link"
              >
                <span class="text-sm font-medium">{link.platform}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="reveal reveal-delay-1 space-y-8" id="proyectos">
      <h2 class="section-title">Proyectos</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {
          PROJECTS.map((project) => (
            <article class="project-card">
              <div class="project-glow" aria-hidden="true" />

              <div>
                <div class="project-header">
                  <h3 class="project-title">{project.title}</h3>
                  <span class="project-kind">Proyecto</span>
                </div>

                <p class="project-description">{project.description}</p>
              </div>

              <div>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="project-tag">#{tag}</span>
                  ))}
                </div>

                <div class="project-actions">
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                  >
                    GitHub ↗
                  </a>
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-link project-link--demo"
                    >
                      Live Demo 🚀
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="reveal reveal-delay-2 space-y-6" id="habilidades">
      <h2 class="section-title">Habilidades</h2>
      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Filtrar habilidades"
      >
        <button
          class="skill-filter"
          type="button"
          data-filter="all"
          aria-pressed="true">Todas</button
        >
        {
          SKILL_CATEGORIES.map((category) => (
            <button
              class="skill-filter"
              type="button"
              data-filter={category.name}
              aria-pressed="false"
            >
              {category.name}
            </button>
          ))
        }
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          SKILL_CATEGORIES.map((category) => (
            <div class="skill-category" data-category={category.name}>
              <h3 class="skill-category-title">{category.name}</h3>
              <div class="skill-list">
                {category.skills.map((skill) => (
                  <span class="skill-tag">{skill}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="reveal reveal-delay-3 space-y-8" id="trayectoria">
      <h2 class="section-title">Experiencia y estudios</h2>
      <div class="grid gap-12 md:grid-cols-2">
        <div class="timeline-panel flex flex-col space-y-6" id="experiencia">
          <h3 class="section-title">Experiencia</h3>
          <div class="timeline-scroll">
            {
              EXPERIENCE.map((experience) => (
                <div>
                  <span class="timeline-item-period">{experience.period}</span>
                  <p class="timeline-item-company">{experience.company}</p>
                  <h4 class="timeline-item-role">{experience.role}</h4>
                  <p class="timeline-item-location">{experience.location}</p>
                  <ul class="timeline-item-list">
                    {experience.responsibilities.map((responsibility) => (
                      <li>{responsibility}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div class="timeline-panel flex flex-col space-y-6" id="estudios">
          <h3 class="section-title">Estudios</h3>
          <div class="timeline-scroll timeline-scroll--education">
            {
              EDUCATION.map((education) => (
                <div>
                  <span class="timeline-item-period timeline-item-period--education">
                    {education.period}
                  </span>
                  <h4 class="timeline-item-role">{education.degree}</h4>
                  <p class="timeline-item-company">{education.institution}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script src="/scripts/skill-filter.js" is:inline></script>
